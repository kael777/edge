# 复制为 projects/a.env 后修改，再执行：
#   ./scripts/register-project.sh a
# PROJECT 必须和文件名一致。
PROJECT=a
DOMAIN=a.example.com

# proxy 或 static，二选一
MODE=proxy
UPSTREAM=a-web:8080
# ROOT=/srv/a

# 可选
BODY_SIZE=16m
WEBSOCKET=1
# 管理面板 /admin-panel/ 白名单，逗号分隔；不填则不额外限制
# ADMIN_ALLOWLIST=203.0.113.10,10.0.0.0/8
# ADMIN_PATH=/admin-panel/
SPA=0
PRIORITY=10
EMAIL=ops@example.com

# auto | letsencrypt | self-signed | none
# auto：有证书就复用，没有且有 EMAIL 就签 Let's Encrypt，否则只上 HTTP
CERT_MODE=auto
STAGING=0
