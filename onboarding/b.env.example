# 项目 B 接入模板。
# 复制到 B 仓库的 deploy/edge.env，填好后交给平台，或由平台复制为：
#   /opt/edge/nginx-gateway/projects/b.env
# PROJECT 必须和最终文件名一致。
PROJECT=b
DOMAIN=b.example.com

# proxy 或 static，二选一
MODE=proxy
UPSTREAM=b-web:8080
# ROOT=/srv/b

# 可选
BODY_SIZE=16m
WEBSOCKET=1
# 管理面板 /admin-panel/ 白名单，逗号分隔；不填则不额外限制
# ADMIN_ALLOWLIST=203.0.113.10,10.0.0.0/8
# ADMIN_PATH=/admin-panel/
SPA=0
PRIORITY=20
EMAIL=ops@example.com

# auto | letsencrypt | self-signed | none
CERT_MODE=auto
STAGING=0
